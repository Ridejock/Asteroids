#pragma once

// Generated by CMake from src/Shared/GameInfo.h.in: do not edit the copy in the build folder.
// The public names of the games are set in ONE place each, the GAME_TITLE and PIXEL_TITLE CMake
// variables (cmake --preset release -DGAME_TITLE="MY NAME"), and used for the window title, the
// title screen logo, the per-user folder, the log file, the .exe's version resource and the zip.

namespace Asteroids::GameInfo {

// One published game: the vector arcade game, or the pixel roguelike.
struct Edition {
    const char* Title;    // shown in the game, upper case
    const char* FileName; // no spaces: .exe, per-user folder, log file, zip
    const char* Tagline;  // under the logo on the store cover
};

inline constexpr Edition kVector{"@GAME_TITLE@", "@GAME_FILE_NAME@", "A VECTOR ARCADE SHOOTER"};
inline constexpr Edition kPixel{"@PIXEL_TITLE@", "@PIXEL_FILE_NAME@", "A PIXEL ROGUELIKE SHOOTER"};

inline constexpr const char* kVersion = "@PROJECT_VERSION@";
inline constexpr const char* kOrganization = "Ridejock"; // per-user folder: <org>/<FileName>
inline constexpr const char* kCopyright = "(C) 2026 ERVIN ASHLEY";

} // namespace Asteroids::GameInfo
